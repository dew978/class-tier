{
  "rules": {
    "config": {
      "teacher": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      },
      "className": {
        ".read": true,
        ".write": "{{T}}"
      },
      "teacherName": {
        ".read": "{{TM}}",
        ".write": "{{T}}"
      },
      "settings": {
        ".read": "{{TM}}",
        ".write": "{{T}}"
      },
      "econ": {
        ".read": "{{TM}}",
        ".write": "{{T}}"
      }
    },
    "users": {
      ".read": "{{TM}}",
      "$uid": {
        ".write": "{{T}}"
      }
    },
    "secrets": {
      ".read": "{{T}}",
      ".write": "{{T}}"
    },
    "activities": {
      ".read": "{{T}}",
      ".write": "{{T}}"
    },
    "entries": {
      ".read": "{{T}}",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('config/teacher').val() === auth.uid)",
        ".write": "{{T}}",
        "$eid": {
          ".write": "{{SELF}} && ({{ENTRY_STUDENT}} || {{ENTRY_SYSTEM}} || (data.exists() && data.child('status').val() === 'pending' && !newData.exists()))"
        }
      }
    },
    "openUnits": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "levels": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "hanja": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "{{SELF}}"
      }
    },
    "standings": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "myDetail": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$month": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "seasons": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },

    "gov": {
      ".read": "{{TM}}",
      ".write": "{{T}}",
      "cash": {
        ".validate": "newData.isNumber() && newData.parent().child('last').val() !== data.parent().child('last').val() && {{GOVCASHOK}}"
      },
      "last": {
        ".validate": "newData.isString() && {{NR2}}.child('feed/' + newData.val() + '/u').val() === '_gov' && !root.child('feed/' + newData.val()).exists()"
      },
      "$other": { ".validate": false }
    },
    "acct": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "cash": {
          ".write": "{{SELF}} && newData.exists() && (newData.val() >= 0 || newData.val() >= data.val())",
          ".validate": "newData.isNumber() && newData.parent().child('last').val() !== data.parent().child('last').val() && {{CASHOK}}"
        },
        "last": {
          ".write": "{{SELF}} && newData.exists()",
          ".validate": "newData.isString() && {{NR3}}.child('feed/' + newData.val() + '/u').val() === $uid && !root.child('feed/' + newData.val()).exists()"
        },
        "items": {
          "$iid": {
            ".write": "{{ITEMW}}",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          }
        },
        "dep": {
          "$did": {
            ".write": "{{DEPW}}",
            ".validate": "newData.hasChildren(['p', 'i', 'r', 's', 'dd']) && newData.child('p').isNumber() && newData.child('i').isNumber() && newData.child('r').isNumber() && newData.child('s').isNumber() && newData.child('dd').isNumber()"
          }
        },
        "hold": {
          "$sid": {
            ".write": "{{HOLDW}}",
            "q": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "c": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        },
        "tc": {
          ".write": "{{TCW}}",
          ".validate": "newData.hasChildren(['d', 'n']) && newData.child('d').isNumber() && newData.child('n').isNumber()"
        },
        "grade": { ".validate": "newData.isString() && newData.val().length <= 4" },
        "avatar": {
          ".write": "{{AVATARW}}",
          ".validate": "newData.hasChildren(['style', 'seed'])"
        },
        "avs": {
          "$aid": {
            ".write": "{{AVSW}}",
            ".validate": "newData.hasChildren(['style', 'seed']) && newData.child('style').isString() && newData.child('style').val().length <= 30"
          }
        },
        "$other": { ".validate": false }
      }
    },
    "feed": {
      ".read": "{{T}} || ({{M}} && query.orderByChild === 'u' && query.equalTo === auth.uid)",
      ".write": "{{T}}",
      ".indexOn": ["u", "t"],
      "$lid": {
        ".write": "{{M}} && !data.exists() && newData.exists() && newData.child('u').val() === auth.uid && newData.child('by').val() === 'S' && {{STUOP}}",
        ".validate": "newData.hasChildren(['u', 'k', 'a', 't', 'by']) && newData.child('u').isString() && newData.child('t').val() === now && (newData.child('by').val() === 'T' || newData.child('by').val() === 'S') && {{TIED}}",
        "k": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "a": { ".validate": "newData.isNumber()" },
        "m": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "n": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "i": { ".validate": "newData.isString()" },
        "s": { ".validate": "newData.isString()" },
        "d": { ".validate": "newData.isString()" },
        "q": { ".validate": "newData.isNumber()" },
        "p": { ".validate": "newData.isNumber()" },
        "g": { ".validate": "newData.isNumber()" },
        "x": { ".validate": "newData.isNumber()" },
        "c": { ".validate": "newData.isNumber()" },
        "src": { ".validate": "newData.isString()" },
        "pr": { ".validate": "newData.isString()" },
        "j": { ".validate": "newData.isString()" },
        "u": { ".validate": true },
        "t": { ".validate": true },
        "by": { ".validate": true },
        "$other": { ".validate": false }
      }
    },
    "feedMark": {
      ".read": "{{T}}",
      ".write": "{{T}}"
    },
    "store": {
      ".write": "{{T}}",
      "items": {
        ".read": "{{TM}}",
        "$iid": {
          "st": {
            ".write": "{{STOCKW}}",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "r": {
            ".write": "{{RAISEW}}",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },
          "n": { ".validate": "newData.isString() && newData.val().length <= 40" }
        }
      },
      "contrib": {
        ".read": "{{T}}",
        "$iid": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && {{RAISEW}}",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "jobs": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "market": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "pub": {
      ".read": true,
      ".write": "{{T}}",
      "symbols": { ".validate": "newData.isString() && newData.val().length <= 500" },
      "$other": { ".validate": false }
    },
    "quests": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "qprog": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$qid": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$per": {
            ".write": "{{SELF}} && ((!data.exists() && {{QREQ}}) || (data.exists() && data.child('st').val() === 'no' && {{QREQ}}) || (data.exists() && data.child('st').val() === 'req' && !newData.exists()))",
            ".validate": "newData.hasChildren(['st', 't'])",
            "st": { ".validate": "newData.val() === 'req' || newData.val() === 'ok' || newData.val() === 'no'" },
            "t": { ".validate": "newData.isNumber()" },
            "txt": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "img": { ".validate": "newData.val() === true" },
            "rt": { ".validate": "newData.isNumber()" },
            "why": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "lid": { ".validate": "newData.isString()" },
            "imp": { ".validate": "newData.val() === true" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "qimg": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$qid": {
        "$uid": {
          "$per": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "{{QIMGW}}"
          }
        }
      }
    },

    "boards": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "bposts": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{BSEE}}",
        "$pid": {
          ".write": "{{BPOSTW}}",
          ".validate": "newData.hasChildren(['u', 't']) && newData.child('u').isString() && newData.child('t').isNumber()",
          "u": { ".validate": true },
          "t": { ".validate": true },
          "e": { ".validate": "newData.isNumber()" },
          "ti": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "tx": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "img": { ".validate": "newData.val() === true" },
          "col": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10" },
          "clr": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "pin": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    },
    "bpend": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{M}} && query.orderByChild === 'u' && query.equalTo === auth.uid",
        ".indexOn": ["u"],
        "$pid": {
          ".read": "auth != null && data.child('u').val() === auth.uid",
          ".write": "{{BPENDW}}",
          ".validate": "newData.hasChildren(['u', 't']) && newData.child('u').isString() && newData.child('t').isNumber()",
          "u": { ".validate": true },
          "t": { ".validate": true },
          "e": { ".validate": "newData.isNumber()" },
          "ti": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "tx": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "img": { ".validate": "newData.val() === true" },
          "col": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10" },
          "clr": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "$other": { ".validate": false }
        }
      }
    },
    "bimg": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        "$pid": {
          ".read": "{{BSEE}} || (auth != null && root.child('bpend/' + $bid + '/' + $pid + '/u').val() === auth.uid)",
          ".write": "{{BIMGW}}"
        }
      }
    },
    "bcmt": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{BSEE}}",
        "$pid": {
          ".write": "{{BWITHPOST}}",
          "$cid": {
            ".write": "{{BCMTW}}",
            ".validate": "newData.hasChildren(['u', 't', 'tx'])",
            "u": { ".validate": "newData.isString()" },
            "t": { ".validate": "newData.isNumber()" },
            "tx": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "brx": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{BSEE}}",
        "$pid": {
          ".write": "{{BWITHPOST}}",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && {{BSEE}} && {{BRD}}.child('rx').val() !== false && root.child('bposts/' + $bid + '/' + $pid).exists()",
            ".validate": "newData.isString() && newData.val().length <= 8"
          }
        }
      }
    },
    "btopic": {
      ".read": "{{TM}}",
      ".write": "{{T}}"
    },
    "bwrite": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{BSEE}} && {{BRD}}.child('share').val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$tid": {
            ".write": "{{BWRITEW}}",
            ".validate": "newData.hasChildren(['t', 'st'])",
            "tx": { ".validate": "newData.isString() && newData.val().length <= 5000" },
            "ti": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "img": { ".validate": "newData.val() === true" },
            "t": { ".validate": "newData.isNumber()" },
            "e": { ".validate": "newData.isNumber()" },
            "st": { ".validate": "newData.val() === 'wait' || newData.val() === 'ok' || newData.val() === 'back'" },
            "fb": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "rt": { ".validate": "newData.isNumber()" },
            "lid": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "bwimg": {
      ".read": "{{T}}",
      ".write": "{{T}}",
      "$bid": {
        ".read": "{{BSEE}} && {{BRD}}.child('share').val() === true",
        "$uid": {
          "$tid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "{{BWIMGW}}"
          }
        }
      }
    }
  }
}
